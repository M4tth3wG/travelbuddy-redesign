# Copy to .env (same directory) and fill in before running `docker compose up`.
# Values below are placeholders. Never commit the real .env file.

# Development enables Swagger UI and the development-only Geoapify/NBP endpoints
ASPNETCORE_ENVIRONMENT=Development

# SA password for the SQL Server container (must meet SQL Server password complexity rules)
MSSQL_SA_PASSWORD=<sql-server-sa-password>

# Geoapify API key (maps to configuration key Geoapify:Key)
GEOAPIFY__KEY=<geoapify-api-key>

# AWS Cognito user pool issuer URL (maps to Cognito:Authority)
# Format: https://cognito-idp.<region>.amazonaws.com/<user-pool-id>
COGNITO__AUTHORITY=<cognito-authority-url>

# Expected token audience (maps to Cognito:Audience; audience validation is currently disabled in Program.cs)
COGNITO__AUDIENCE=<cognito-audience>
