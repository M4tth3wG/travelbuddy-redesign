# Copy to .env (same directory) and fill in before running `npm start`.
# Values below are placeholders. Never commit the real .env file.

# Base URL of the TravelBuddy API reachable from the device/emulator,
# e.g. http://<your-machine-lan-ip> when using the backend docker compose setup (host port 80)
EXPO_PUBLIC_API_URL=<api-base-url>

# AWS Cognito user pool used for sign-up / sign-in
EXPO_PUBLIC_COGNITO_REGION=<aws-region>
EXPO_PUBLIC_COGNITO_USER_POOL_ID=<cognito-user-pool-id>
EXPO_PUBLIC_COGNITO_CLIENT_ID=<cognito-app-client-id>

# UI variant: v1 (baseline), v2 or v3
EXPO_PUBLIC_FEATURE_VERSION=v1
